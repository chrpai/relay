<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plain console program with no NuGet packages: run it with `dotnet run`.
       It compiles the relay engine straight from the service project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TelnetRelay\TelnetRelay.csproj" />
  </ItemGroup>

</Project>
